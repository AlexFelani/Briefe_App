# ===== Briefe-Server: Einstellungen =====  (Kopie als .env anlegen; .env niemals veröffentlichen)

# Adressen
PORT=3000
APP_URL=https://app.deine-domain.de          # wo die App liegt (für Links in E-Mails, CORS, LUKSO-Prüfung)
API_URL=https://api.deine-domain.de          # öffentliche Adresse dieses Servers
DB_FILE=./data/briefe.db

# KI – empfohlen: Amazon Bedrock mit EU-Profil (Verarbeitung in EU-Rechenzentren)
AI_PROVIDER=bedrock
BEDROCK_REGION=eu-central-1
BEDROCK_MODEL=eu.anthropic.claude-sonnet-5-5
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Alternative: direkt bei Anthropic (Verarbeitung laut Anbieter in den USA)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Preise und Gratis-Briefe (müssen mit AGB und App übereinstimmen)
PAYMENT_REQUIRED=false                       # true = ab Brief 3 kostenpflichtig
FREE_LETTERS=2
FREE_MAX_PAGES=10
FREE_REQUIRES_LOGIN=true                     # Gratis-Briefe nur nach Anmeldung (schützt vor Missbrauch)
BASE_PRICE_CENTS=200                         # 2,00 € bis 10 Seiten
EXTRA_PAGE_CENTS=10                          # 0,10 € je weitere Seite
BASE_PAGES=10
WITHDRAWAL_DAYS=14
SUB_ENABLED=false
SUB_NAME=Briefe-Abo
SUB_PRICE_CENTS=499
TERMS_VERSION=2026-11                        # Fassung der AGB, wird bei jeder Bestellung gespeichert

# Stripe (erst im Testmodus mit sk_test_… ausprobieren)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-Mail (SMTP eines EU-Anbieters; leer = E-Mails erscheinen nur in der Konsole)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@deine-domain.de
MAIL_FROM_NAME=Briefe-App
OPERATOR_EMAIL=                              # hierhin gehen Hinweise, z. B. zu prüfende Widerrufe

# Push-Erinnerungen: Schlüssel mit "npm run vapid" erzeugen
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:kontakt@deine-domain.de

# LUKSO (Standard: Adressen aus der LUKSO-Dokumentation)
# LUKSO_RPC_MAINNET=https://42.rpc.thirdweb.com
# LUKSO_RPC_TESTNET=https://rpc.testnet.lukso.network

# ---------- Weitere Clouds ----------
# WebDAV-Weiterleitung für MagentaCLOUD, GMX, WEB.DE, HiDrive und Nextcloud (false = aus)
DAV_ENABLED=true
# Größte Datei in MB, die über die Weiterleitung laufen darf
DAV_MAX_MB=25
# Box: App unter https://app.box.com/developers/console anlegen (OAuth 2.0),
# Redirect-Adresse = Adresse der App, unter "CORS Domains" die Adresse der App eintragen
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
